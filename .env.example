# Discord bot token from https://discord.com/developers/applications
# Copy this file to ".env" and fill in your real token. Never commit ".env".
DISCORD_TOKEN=your_bot_token_here

# Channel where welcome messages are posted (channel name, no #)
WELCOME_CHANNEL=welcome

# Optional but RECOMMENDED if !social will mostly share the school's own
# Instagram/Facebook posts: lets the bot fetch real data (image, caption,
# hashtags, AND real like counts) directly via the Graph API, using a token
# the school generates by logging in themselves — no scraping involved. See
# README.md "Social media embeds: setting up the owned-account API" for the
# one-time setup (link the IG account to a Page, create a Meta app, get a
# long-lived Page access token). Leave blank to skip this strategy — !social
# will still work via the fallbacks below, just less reliably for Instagram.
META_PAGE_ID=
META_IG_USER_ID=
META_PAGE_ACCESS_TOKEN=

# Optional: enables Meta's official oEmbed API for !social / !embed metadata
# lookups on posts NOT covered by the owned-account settings above (more
# reliable than the Open Graph fallback the bot uses otherwise). Create an
# app at https://developers.facebook.com/apps, and note that Meta gates
# "oEmbed Read" behind App Review for posts you don't own — without that
# approval these calls will just fail silently and the bot falls back to
# scraping Open Graph tags instead. Leave blank to skip oEmbed entirely.
META_APP_ID=
META_APP_SECRET=
