# Discord bot token from https://discord.com/developers/applications
# Copy this file to ".env" and fill in your real token. Never commit ".env".
DISCORD_TOKEN=your_bot_token_here

# Channel where welcome messages are posted (channel name, no #)
WELCOME_CHANNEL=welcome

# Optional: enables Meta's official oEmbed API for !social / !embed metadata
# lookups (more reliable than the Open Graph fallback the bot uses otherwise).
# Create an app at https://developers.facebook.com/apps, and note that Meta
# gates "oEmbed Read" behind App Review for posts you don't own — without
# that approval these calls will just fail silently and the bot falls back
# to scraping Open Graph tags instead. Leave blank to skip oEmbed entirely.
META_APP_ID=
META_APP_SECRET=
