# Discord bot token from https://discord.com/developers/applications
# Copy this file to ".env" and fill in your real token. Never commit ".env".
DISCORD_TOKEN=your_bot_token_here

# Channel where welcome messages are posted (channel name, no #)
WELCOME_CHANNEL=welcome

# Lavalink server for music playback (!play etc.) — this is a SEPARATE server
# process you must run/host yourself (Java 17+, or the
# ghcr.io/lavalink-devs/lavalink:4 Docker image); "pip install wavelink" does
# not provide one. See README.md "Music (Lavalink) setup" before using music
# commands. If unset, these defaults assume a local Lavalink on this machine.
LAVALINK_URI=http://localhost:2333
LAVALINK_PASSWORD=youshallnotpass
